{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vuena-assets",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./worker/public",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*"]
  },
  "observability": { "enabled": false }
}
